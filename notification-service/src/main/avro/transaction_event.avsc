{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.finaccounthub.avro",
  "doc": "계좌 입출금/이체 거래 발생 시 발행되는 이벤트. BACKWARD 호환성 유지를 위해 신규 필드는 반드시 default 값을 가져야 함. v2: 요구사항 정리 문서(fromAccount/toAccount FK 분리, status) 반영 — fromAccountId/toAccountId/status 추가.",
  "fields": [
    { "name": "transactionId", "type": "string", "doc": "거래 고유 ID (UUID)" },
    { "name": "accountId", "type": "string", "doc": "거래 대상 계좌 ID (하위 호환용, DEPOSIT/WITHDRAW 시 대상 계좌, TRANSFER 시 fromAccountId와 동일)" },
    { "name": "userId", "type": "string", "doc": "거래 요청 사용자 ID" },
    { "name": "transactionType", "type": "string", "doc": "DEPOSIT | WITHDRAW | TRANSFER (요구사항 정리 문서 기준)" },
    { "name": "amount", "type": "long", "doc": "거래 금액 (원 단위)" },
    { "name": "occurredAt", "type": "string", "doc": "거래 발생 시각 (ISO-8601)" },
    { "name": "fromAccountId", "type": ["null", "string"], "default": null, "doc": "출금/이체 출발 계좌 ID (DEPOSIT은 null). 요구사항 정리(2) API 응답의 fromAccountId 대응" },
    { "name": "toAccountId", "type": ["null", "string"], "default": null, "doc": "입금/이체 도착 계좌 ID (WITHDRAW는 null). 요구사항 정리(2) API 응답의 toAccountId 대응" },
    { "name": "status", "type": "string", "default": "SUCCESS", "doc": "PENDING | SUCCESS | FAILED (Saga 보상 트랜잭션 대응, 요구사항 정리 문서 Transaction DB status)" }
  ]
}
